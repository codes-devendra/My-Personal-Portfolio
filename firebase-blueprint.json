{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public portfolio profile and personal metadata configured by the portfolio owner.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "pronouns": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "maxLength": 150 },
        "headline": { "type": "string", "maxLength": 300 },
        "bio": { "type": "string", "maxLength": 1000 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "location": { "type": "string", "maxLength": 100 },
        "timezone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 30 },
        "statusText": { "type": "string", "maxLength": 200 },
        "yearsOfExperience": { "type": "number" },
        "projectsCompleted": { "type": "number" },
        "clientsSatisfied": { "type": "number" },
        "openSourceContributions": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "role", "email"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Inbound inquiry or project message submitted through the contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 200 },
        "budget": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["name", "email", "message"]
    },
    "GuestbookEntry": {
      "title": "GuestbookEntry",
      "description": "Community guestbook note left by visiting viewers or collaborators.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 500 },
        "message": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "userName", "message"]
    }
  },
  "firestore": {
    "/portfolio/profile": {
      "schema": "UserProfile",
      "description": "Singleton document storing the active portfolio owner profile settings and biography."
    },
    "/messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Collection of contact inquiries sent to the portfolio owner."
    },
    "/guestbook/{entryId}": {
      "schema": "GuestbookEntry",
      "description": "Public guestbook notes and greetings left by verified viewers."
    }
  }
}
